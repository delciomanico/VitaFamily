# Copiar para deploy/.env (fora do Git) na VPS e preencher com segredos de produção.
# Usado por docker-compose.api.prod.yml. Gerar palavras-passe/chaves: openssl rand -base64 32
# Nomes de serviço (postgres/minio/clamav) resolvem-se pela rede dokploy-network — não usar
# 127.0.0.1 nem localhost aqui (isso é só para deploy/.env de desenvolvimento).

# Aplicação
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://vitafamily.cassfrei.com
PWA_ORIGIN=https://vitafamily.cassfrei.com
LOG_LEVEL=info
TERMS_VERSION=

# PostgreSQL
POSTGRES_USER=vita
POSTGRES_DB=vita
POSTGRES_PASSWORD=
DATABASE_URL=postgres://vita:<POSTGRES_PASSWORD>@postgres:5432/vita

# Armazenamento S3/MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_USE_SSL=false
S3_REGION=eu-west-1
S3_BUCKET_DOCUMENTS=vita-documents
S3_BUCKET_EXPORTS=vita-exports
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Antivírus (ClamAV)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Autenticação
JWT_SIGNING_KEYS=
JWT_ACCESS_TTL=15m
REFRESH_TTL=30d
COOKIE_DOMAIN=vitafamily.cassfrei.com

# E-mail (fornecedor SMTP real — nunca Mailhog em produção). Decisão do proprietário: Brevo
# (UE por omissão, DPA incluído, 300 e-mails/dia grátis — suficiente para o volume do Vita
# Family). Login = e-mail da conta Brevo; a senha é a SMTP key gerada em SMTP & API -> SMTP,
# não a password da conta. Confirmar SPF/DKIM do domínio de MAIL_FROM no painel do Brevo.
SMTP_URL=smtps://<login-brevo>:<smtp-key-brevo>@smtp-relay.brevo.com:465
MAIL_FROM=no-reply@vitafamily.cassfrei.com

# Web Push (gerar: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@cassfrei.com

# Limites
UPLOAD_MAX_BYTES=10485760
FAMILY_STORAGE_QUOTA_BYTES=104857600

# Backups (deploy/scripts/backup-postgres.sh, deployment.md §5) — segredo próprio, nunca igual
# aos de cima; sem ele o backup falha em vez de gravar o dump em claro.
BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_DIR=/var/backups/vitafamily/postgres
# BACKUP_RETENTION_DAYS=30
