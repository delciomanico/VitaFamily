# Copiar para deploy/.env (fora do Git) na VPS e preencher com segredos de produção.
# Usado por docker-compose.api.prod.yml. Gerar palavras-passe/chaves: openssl rand -base64 32
# Nomes de serviço (postgres/redis/minio/clamav) resolvem-se pela rede dokploy-network — não usar
# 127.0.0.1 nem localhost aqui (isso é só para deploy/.env de desenvolvimento).

# Aplicação
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://vitafamily.cassfrei.com
PWA_ORIGIN=https://vitafamily.cassfrei.com
LOG_LEVEL=info
# Saltos de proxy confiáveis para req.ip (limites por IP). Topologia do repo: cliente -> Traefik
# (Dokploy) -> nginx do web -> api = 2. Se houver CDN/Cloudflare à frente do Traefik: 3. Também
# aceita lista de IP/CIDR. Confirmar na VPS (ver relatório) antes de fixar; default da app = 1.
TRUST_PROXY=2
TERMS_VERSION=

# PostgreSQL
POSTGRES_USER=vita
POSTGRES_DB=vita
POSTGRES_PASSWORD=
DATABASE_URL=postgres://vita:<POSTGRES_PASSWORD>@postgres:5432/vita

# Redis dos limitadores de taxa (ADR-038). Segredos no Dokploy, nunca no repositório.
# REDIS_PASSWORD: openssl rand -base64 24 (só se usa no serviço redis e dentro de REDIS_URL;
# se tiver "@ / + =", percent-encode em REDIS_URL). RATE_LIMIT_KEY_SECRET: openssl rand -base64 32,
# distinto de qualquer outro ambiente. Produção recusa RATE_LIMIT_BACKEND=memory e arranque sem
# REDIS_URL/RATE_LIMIT_KEY_SECRET.
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_COMMAND_TIMEOUT_MS=200
REDIS_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_KEY_PREFIX=vita:production
RATE_LIMIT_KEY_SECRET=

# Armazenamento S3/MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_USE_SSL=false
S3_REGION=eu-west-1
S3_BUCKET_DOCUMENTS=vita-documents
S3_BUCKET_EXPORTS=vita-exports
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Antivírus (ClamAV)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Autenticação
JWT_SIGNING_KEYS=
JWT_ACCESS_TTL=15m
REFRESH_TTL=30d
COOKIE_DOMAIN=vitafamily.cassfrei.com

# E-mail (fornecedor SMTP real — nunca Mailhog em produção). Decisão do proprietário: Brevo
# (UE por omissão, DPA incluído, 300 e-mails/dia grátis — suficiente para o volume do Vita
# Family). Login = valor exato em SMTP & API -> SMTP (não o e-mail da conta; algo como
# "xxxxx@smtp-brevo.com"); a senha é a SMTP key gerada na mesma página, não a password da
# conta. Porta 587 = STARTTLS -> esquema smtp:// (não smtps://). Se o login ou a key tiverem
# caracteres "@ / + =", fazer percent-encode (é um URL). Confirmar SPF/DKIM do domínio de
# MAIL_FROM no painel do Brevo.
SMTP_URL=smtp://<login-smtp-brevo>:<smtp-key-brevo>@smtp-relay.brevo.com:587
MAIL_FROM=no-reply@vitafamily.cassfrei.com

# Web Push (gerar: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@cassfrei.com

# Limites
UPLOAD_MAX_BYTES=10485760
FAMILY_STORAGE_QUOTA_BYTES=104857600

# Backups (deploy/scripts/backup-postgres.sh, deployment.md §5) — segredo próprio, nunca igual
# aos de cima; sem ele o backup falha em vez de gravar o dump em claro.
BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_DIR=/var/backups/vitafamily/postgres
# BACKUP_RETENTION_DAYS=30
