# Copiar para .env (fora do Git) e preencher. Valores NUNCA no repositório.
# Gerar palavras-passe: openssl rand -base64 24

# Aplicação
APP_ENV=local
PORT=8080
APP_BASE_URL=http://localhost:8080
PWA_ORIGIN=
LOG_LEVEL=info
# Saltos de proxy confiáveis para req.ip. Dev direto à API (sem proxy): 0; via nginx do web (make): 1.
# Produção (Traefik -> nginx -> api): ver deploy/.env.production.example (2).
TRUST_PROXY=1
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
SHUTDOWN_TIMEOUT=15s
# Versão atual dos termos de serviço aceites no registo/login (B6).
TERMS_VERSION=1.0.0

# Autenticação (M1): lista JSON [{"kid":"...","secret":"..."}], secret com >=32 caracteres.
# A primeira entrada assina tokens novos; as restantes só verificam tokens antigos (rotação).
# Gerar secret: openssl rand -base64 32
JWT_SIGNING_KEYS=

# PostgreSQL (docker-compose.dev.yml; a API usa DATABASE_URL)
POSTGRES_USER=vita
POSTGRES_DB=vita
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis dos limitadores de taxa (ADR-038; docker-compose.dev.yml). REDIS_PASSWORD: openssl rand -base64 24
# REDIS_URL: redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0 (API no host) ou @redis:6379/0 (API em contentor).
# Sem Redis (só dev/testes): RATE_LIMIT_BACKEND=memory (a produção recusa-o no arranque).
REDIS_PASSWORD=
REDIS_URL=
REDIS_COMMAND_TIMEOUT_MS=200
REDIS_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_BACKEND=redis
# Opcional (default vita:<NODE_ENV>)
RATE_LIMIT_KEY_PREFIX=
# >=32 bytes, distinto por ambiente: openssl rand -base64 32
RATE_LIMIT_KEY_SECRET=

# Armazenamento S3/MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_USE_SSL=false
S3_BUCKET_DOCUMENTS=vita-documents
S3_BUCKET_EXPORTS=vita-exports
S3_ACCESS_KEY=
S3_SECRET_KEY=

# E-mail (Mailhog em dev: smtp://mailhog:1025)
SMTP_URL=
MAIL_FROM=
